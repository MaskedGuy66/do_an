GEMINI_API_KEY=your_gemini_api_key_here

# Admin API Key – bảo vệ các endpoint quản trị (tạo/sửa/xóa job, xem hồ sơ)
# Đặt giá trị ngẫu nhiên mạnh, ví dụ: openssl rand -hex 32
ADMIN_API_KEY=change_me_before_production

# CORS – danh sách origin cho phép, cách nhau bằng dấu phẩy
# Ví dụ production: https://recruit.yourcompany.com,https://admin.yourcompany.com
# Để trống hoặc * → cho phép tất cả (chỉ dùng khi development)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000